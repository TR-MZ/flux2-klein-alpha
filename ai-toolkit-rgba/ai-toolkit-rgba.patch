+        from transformers.integrations import deepspeed as td
+    except Exception:
+        with nullcontext():
+            yield
+        return
+
+    previous = td._hf_deepspeed_config_weak_ref
+    td._hf_deepspeed_config_weak_ref = None
+    try:
+        yield
+    finally:
+        td._hf_deepspeed_config_weak_ref = previous
+
