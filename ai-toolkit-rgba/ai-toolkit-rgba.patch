+class ShardedDataLoader:
+    def __init__(self, dataloader: DataLoader, process_index: int, num_processes: int):
+        self.dataloader = dataloader
+        self.process_index = process_index
+        self.num_processes = max(1, num_processes)
+        self.dataset = dataloader.dataset
+
+    def __iter__(self):
+        try:
+            dataloader_len = len(self.dataloader)
+        except TypeError:
+            dataloader_len = None
+
+        should_shard = self.num_processes > 1 and (dataloader_len is None or dataloader_len >= self.num_processes)
+        for idx, batch in enumerate(self.dataloader):
+            if not should_shard or idx % self.num_processes == self.process_index:
+                yield batch
+
+    def __len__(self):
+        dataloader_len = len(self.dataloader)
+        if self.num_processes <= 1 or dataloader_len < self.num_processes:
+            return dataloader_len
+        return (dataloader_len + self.num_processes - 1 - self.process_index) // self.num_processes
+
+    def __getattr__(self, name):
+        return getattr(self.dataloader, name)
+
