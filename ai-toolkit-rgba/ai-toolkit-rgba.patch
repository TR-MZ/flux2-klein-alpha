+@contextmanager
+def no_zero3_init():
+    """Load a frozen model without deepspeed zero3 sharding it across ranks.
+
+    transformers wraps `from_pretrained` in `deepspeed.zero.Init` whenever
+    `is_deepspeed_zero3_enabled()` is true, which partitions the new model's
+    weights. That is wrong for anything we only run inference on (the text
+    encoder here): the shards would need a gather on every forward, and when
+    only some ranks load it - as with a deferred text encoder - the partitioning
+    collective deadlocks the ones that did.
