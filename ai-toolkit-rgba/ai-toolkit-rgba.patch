diff --git a/ui/src/helpers/gpuOptions.ts b/ui/src/helpers/gpuOptions.ts
new file mode 100644
index 0000000..fa3d701
--- /dev/null
+++ b/ui/src/helpers/gpuOptions.ts
@@ -0,0 +1,39 @@
+import type { GpuInfo, SelectOption } from '@/types';
+
+export function getFirstTwoGpuIDs(gpuList: GpuInfo[] = []): string | null {
+  const sortedGpus = [...gpuList].sort((a, b) => a.index - b.index);
+  if (sortedGpus.length < 2) {
+    return null;
+  }
+  return `${sortedGpus[0].index},${sortedGpus[1].index}`;
+}
+
+export function getGpuSelectOptions(gpuList: GpuInfo[] = []): SelectOption[] {
+  const sortedGpus = [...gpuList].sort((a, b) => a.index - b.index);
+  const options = sortedGpus.map(gpu => ({
+    value: `${gpu.index}`,
+    label: `GPU #${gpu.index}`,
+  }));
+
+  if (sortedGpus.length > 1) {
+    for (let i = 0; i < sortedGpus.length; i++) {
+      for (let j = i + 1; j < sortedGpus.length; j++) {
+        options.push({
+          value: `${sortedGpus[i].index},${sortedGpus[j].index}`,
+          label: `GPUs #${sortedGpus[i].index}, #${sortedGpus[j].index}`,
+        });
+      }
+    }
+  }
+
+  if (sortedGpus.length > 2) {
+    const combinedIds = sortedGpus.map(gpu => gpu.index).join(',');
+    const combinedLabel = sortedGpus.map(gpu => `#${gpu.index}`).join(', ');
+    options.push({
+      value: combinedIds,
+      label: `GPUs ${combinedLabel}`,
+    });
+  }
+
+  return options;
+}
